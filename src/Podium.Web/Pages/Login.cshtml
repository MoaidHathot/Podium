@page "/login"
@model Podium.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
    var safeReturn = Model.ReturnUrl;
    var caller = Model.Caller;
}
<div class="hero">
    <svg width="48" height="48" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5h-5v2h3a1 1 0 1 1 0 2h-9a1 1 0 1 1 0-2h3v-2h-5A1.5 1.5 0 0 1 4 14.5v-9Z" fill="var(--accent)"/></svg>
    <h1>Podium</h1>
    @if (caller.IsAuthenticated && !caller.IsOwner)
    {
        <p>You are signed in as <strong>@caller.DisplayName</strong>, but this deck or page is not shared with you.</p>
        <div class="row">
            <a class="btn" href="/shared">Decks shared with me</a>
            <form method="post" action="/logout" class="inline">@Html.AntiForgeryToken()<button class="btn btn-ghost" type="submit">Sign out</button></form>
        </div>
    }
    else
    {
        @if (Model.Error == "denied")
        {
            <div class="alert alert-warn" role="alert">GitHub did not authorise Podium. Nothing was signed in; try again whenever you like.</div>
        }
        else if (Model.Error == "failed")
        {
            <div class="alert alert-bad" role="alert">Signing in with GitHub did not complete. This is usually a timing problem between the two sites; trying again normally works.</div>
        }
        else if (Model.Known)
        {
            <p>You signed out of Podium on this device. Sign in again to continue.</p>
        }
        else
        {
            <p>Sign in with GitHub to continue. Access to private decks is granted by the owner.</p>
        }
        @if (Model.OAuthConfigured)
        {
            <a class="btn btn-primary btn-lg" href="/login/github?returnUrl=@Uri.EscapeDataString(safeReturn)" id="login-github">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A12 12 0 0 0 0 12.7c0 5.4 3.4 10 8.2 11.6.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.8 1.3 1.8 1.3 1.1 1.9 2.8 1.4 3.5 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.4-5.5-6.1 0-1.3.5-2.4 1.2-3.3-.1-.3-.5-1.6.1-3.3 0 0 1-.3 3.3 1.3a11.3 11.3 0 0 1 6 0c2.3-1.6 3.3-1.3 3.3-1.3.7 1.7.3 3 .1 3.3.8.9 1.2 2 1.2 3.3 0 4.7-2.8 5.8-5.5 6.1.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 24 12.7 12 12 0 0 0 12 .5Z"/></svg>
                @(Model.Error is not null || Model.Known ? "Continue with GitHub" : "Sign in with GitHub")
            </a>
            <p class="faint" style="font-size:.85rem; max-width:40ch">GitHub only confirms who you are; Podium stores your GitHub id, login and avatar, nothing else. Stays signed in on this device for two weeks of use.</p>
        }
        else if (!Model.DevLogin)
        {
            <div class="alert alert-warn">GitHub sign-in is not configured on this instance.</div>
        }
        @if (Model.DevLogin)
        {
            <div class="row" style="margin-top:1rem">
                <a class="btn" href="/dev-login?returnUrl=@Uri.EscapeDataString(safeReturn)">Dev: sign in as owner</a>
                <a class="btn btn-ghost" href="/dev-login-guest?returnUrl=@Uri.EscapeDataString(safeReturn)">Dev: sign in as guest</a>
            </div>
        }
    }
</div>
