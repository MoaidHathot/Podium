@model bool
@* Sort / group / direction controls of the talks catalog. The model says whether the viewer is the owner (status grouping). *@
<label class="control"><span class="control-label">Group by</span>
    <select id="talk-group" class="input" aria-label="Group by">
        <option value="none">No grouping</option>
        @if (Model) { <option value="status">Status</option> }
        <option value="kind">Talks / courses</option>
        <option value="level">Level</option>
        <option value="yeargiven">Year given</option>
    </select>
</label>
<label class="control"><span class="control-label">Sort</span>
    <select id="talk-sort" class="input" aria-label="Sort by">
        <option value="active">Recently active</option>
        <option value="given">Last given</option>
        <option value="next">Next event</option>
        <option value="title">Title A–Z</option>
        <option value="decks">Most decks</option>
        <option value="events">Most events</option>
    </select>
</label>
<button type="button" class="btn btn-ghost btn-sm" id="talk-dir" aria-pressed="false" title="Newest first; click for oldest first">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg><span class="sr-only">Sort direction</span>
</button>
