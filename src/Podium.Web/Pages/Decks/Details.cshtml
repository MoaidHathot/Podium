@page "/decks/{slug}"
@model Podium.Web.Pages.Decks.DetailsModel
@{
    var d = Model.Deck;
    ViewData["Title"] = d.Title;
    var kind = d.Kind.ToString().ToLowerInvariant();
    var servable = d.CurrentBuildId is not null && d.Kind != DeckKind.GitPitch;
    var isDoc = d.Kind is DeckKind.PowerPoint or DeckKind.Pdf;
    var kindLabel = d.Kind switch { DeckKind.Static => "HTML", DeckKind.PowerPoint => "PowerPoint", DeckKind.Pdf => "PDF", _ => d.Kind.ToString() };
    var building = d.LatestBuildStatus is BuildStatus.Queued or BuildStatus.Running;
    string VisName(Visibility v) => v switch { Visibility.Public => "Public", Visibility.Link => "Link", Visibility.Shared => "Shared", _ => "Private" };
}

<p><a href="/" class="muted">← Library</a></p>

<div class="deck-hero" style="margin-bottom:1.25rem">
<div>
<div class="row-between" style="align-items:flex-start">
    <div style="min-width:0">
        <h1 id="title">@d.Title</h1>
        <div class="row" style="margin-top:.35rem; gap:.5rem">
            <span class="badge badge-kind-@kind">@kindLabel</span>
            <span class="muted mono" style="font-size:.85rem">@(Model.Source?.FullName ?? d.SourceId)@(string.IsNullOrEmpty(d.Path) ? "" : "/" + d.Path)/@d.Entry</span>
            @if (Model.Source is { Trusted: false })
            {
                <span class="badge" title="From a repository you do not control. Served in a sandboxed origin.">External</span>
            }
        </div>
        @if (d.Author is not null || d.Description is not null)
        {
            <p class="muted" style="margin-top:.5rem">@d.Author@(d.Author is not null && d.Description is not null ? " · " : "")@d.Description</p>
        }
    </div>
    <div class="row">
        <button class="btn" id="pin" aria-pressed="@(d.Pinned ? "true" : "false")">@(d.Pinned ? "Unpin" : "Pin")</button>
        <button class="btn @(d.PinnedBuildId is not null ? "btn-frozen" : "")" id="freeze" aria-pressed="@(d.PinnedBuildId is not null ? "true" : "false")" title="While frozen, new pushes still build but the served version does not change until you unfreeze or promote a build" @(servable ? "" : "disabled")>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2v20M4.9 6l14.2 12M4.9 18 19.1 6M2 12h20"/></svg>
            @(d.PinnedBuildId is not null ? "Frozen" : "Freeze")
        </button>
        <button class="btn" id="rebuild" @(building ? "disabled" : "")>@(building ? "Building…" : "Rebuild")</button>
    </div>
</div>
</div>
@if (d.CurrentHasThumbnail && d.CurrentBuildId is not null)
{
    <a href="/d/@d.Slug/" target="_blank" rel="noopener" title="Open"><img src="/d/@(d.Slug).jpg?v=@d.CurrentBuildId" alt="First slide of @d.Title" /></a>
}
</div>

@if (d.PinnedBuildId is not null)
{
    <div class="alert alert-info"><strong>Frozen.</strong> Serving build <span class="mono">@d.PinnedBuildId.Substring(0, Math.Min(14, d.PinnedBuildId.Length))</span>@(d.LatestSuccessfulBuildId is not null && d.LatestSuccessfulBuildId != d.CurrentBuildId ? "; a newer successful build is waiting" : ""). New pushes keep building in the background; unfreeze to catch up, or use <em>Serve</em> on a build below.</div>
}
@if (Model.NotBuilt && !servable)
{
    <div class="alert alert-warn">This deck has no successful build yet, so it cannot be presented. @(building ? "A build is in progress." : "Check the latest build below or trigger a rebuild.")</div>
}
@if (d.LatestBuildStatus == BuildStatus.Failed && Model.Builds.FirstOrDefault() is { Error: { } err })
{
    <div class="alert alert-bad"><strong>Last build failed:</strong> @err</div>
}
@if (Model.CurrentBuild?.Warnings.Count > 0)
{
    <div class="alert alert-info"><strong>Remote limitations:</strong>
        <ul style="margin:.3rem 0 0 1rem">@foreach (var w in Model.CurrentBuild.Warnings) { <li>@w</li> }</ul>
    </div>
}
@{
    var latestWithFindings = Model.Builds.FirstOrDefault(b => b.Annotations.Count > 0 && (b.Id == d.LatestBuildId || b.Id == d.CurrentBuildId));
}
@if (latestWithFindings is not null)
{
    <div class="alert @(latestWithFindings.Annotations.Any(a => a.Level == AnnotationLevel.Failure) ? "alert-bad" : "alert-info")"><strong>Deck health (@latestWithFindings.Annotations.Count finding@(latestWithFindings.Annotations.Count == 1 ? "" : "s")):</strong>
        <ul style="margin:.3rem 0 0 1rem">
        @foreach (var a in latestWithFindings.Annotations.Take(12))
        {
            <li><span class="mono">@a.Path:@a.Line</span> &mdash; @a.Message
                @if (Model.Source is not null) { <a href="https://github.com/@Model.Source.FullName/blob/@latestWithFindings.Sha/@a.Path#L@a.Line" rel="noreferrer" target="_blank" style="margin-left:.3rem">open</a> }
            </li>
        }
        @if (latestWithFindings.Annotations.Count > 12) { <li class="faint">and @(latestWithFindings.Annotations.Count - 12) more (see the check run on the commit)</li> }
        </ul>
    </div>
}

<div class="two-col">
    <section class="panel">
        <h3>@(isDoc ? "View" : "Present")</h3>
        <p class="hint">@(isDoc ? "Opens the PDF rendition in the browser; the original file is available below." : "Open the deck on the presenting machine, and the presenter view on your own device. The presenter view drives all other open instances of this deck.")</p>
        <div class="row">
            <a class="btn btn-primary" href="/d/@d.Slug/" target="_blank" rel="noopener" aria-disabled="@(servable ? null : "true")">@(isDoc ? "Open" : "Open deck")</a>
            @if (d.Kind == DeckKind.Slidev)
            {
                <a class="btn" href="/d/@d.Slug/presenter/" target="_blank" rel="noopener" aria-disabled="@(servable ? null : "true")">Presenter view</a>
                <a class="btn" href="/d/@d.Slug/overview/" target="_blank" rel="noopener" aria-disabled="@(servable ? null : "true")">Overview</a>
            }
        </div>
        <div style="margin-top:1rem" class="field">
            <label>Deck URL</label>
            <div class="url-box"><code>@Model.Origin/d/@d.Slug/</code><button class="btn btn-sm" data-copy="@Model.Origin/d/@d.Slug/">Copy</button></div>
        </div>
        <div style="margin-top:.75rem" class="field">
            <label for="alias">Short alias <span class="faint">(optional; <code>@Model.Origin/d/&lt;alias&gt;/</code> redirects here)</span></label>
            <div class="row" style="gap:.4rem">
                <input class="input" id="alias" value="@d.Alias" placeholder="e.g. agents" style="max-width:16rem" maxlength="60" />
                <button class="btn btn-sm" id="alias-save">Save</button>
                @if (!string.IsNullOrEmpty(d.Alias)) { <button class="btn btn-sm" data-copy="@Model.Origin/d/@(d.Alias)/">Copy alias URL</button> }
            </div>
        </div>
        <div style="margin-top:.75rem" class="field">
            <label for="tags">Tags <span class="faint">(comma-separated; searchable and filterable in the library)</span></label>
            <div class="row" style="gap:.4rem">
                <input class="input" id="tags" value="@string.Join(", ", d.Tags)" placeholder="ai, agents, conference" style="max-width:28rem" />
                <button class="btn btn-sm" id="tags-save">Save</button>
            </div>
        </div>
        @if (servable)
        {
            var live = Model.LiveSession;
            var joinCode = live?.JoinCode is { } jc ? Podium.Core.Services.SessionService.FormatJoinCode(jc) : null;
            var joinUrl = live?.JoinCode is { } jc2 ? Podium.Core.Services.SessionService.JoinUrl(new Uri(Model.PublicOrigin), jc2) : null;
            var plainWorksForRoom = d.Visibility == Visibility.Public;
            <div class="follow" id="follow-along" style="margin-top:1rem">
                <strong>Let the room follow along</strong>
                @if (live is not null && joinUrl is not null)
                {
                    <p class="hint" style="margin:.2rem 0 .6rem">You are live. Anyone who opens this link follows your navigation; no sign-in needed, even for a Private deck. It stops working when you end the session.</p>
                    <div class="row" style="align-items:flex-start; gap:1.25rem; flex-wrap:wrap">
                        <a href="/d/@d.Slug/qr.svg?join=1" target="_blank" rel="noopener" title="Open the QR code full-screen for the room"><img class="qr" src="/d/@d.Slug/qr.svg?join=1" alt="QR code of the join link" width="132" height="132" /></a>
                        <div style="flex:1; min-width:16rem">
                            <div class="join-code" title="Read this aloud">@joinCode</div>
                            <div class="url-box" style="margin-top:.4rem"><code>@joinUrl</code><button class="btn btn-sm" data-copy="@joinUrl">Copy</button></div>
                            <div class="row" style="margin-top:.5rem; gap:.4rem; flex-wrap:wrap">
                                <button class="btn btn-sm" data-share-url="@joinUrl" data-share-title="@d.Title" data-share-text="Follow along: @joinUrl">Share…</button>
                                <a class="btn btn-sm" href="mailto:?subject=@Uri.EscapeDataString(d.Title)&body=@Uri.EscapeDataString($"Follow along live: {joinUrl}")">Email</a>
                                <a class="btn btn-sm" href="/d/@d.Slug/qr.svg?join=1" target="_blank" rel="noopener">QR full-screen</a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="hint" style="margin:.2rem 0 .6rem">
                        @if (plainWorksForRoom)
                        {
                            <text>This deck is Public, so the plain link and QR work for anyone. <strong>Go live</strong> below to also get a short join code (<code>@Model.PublicOrigin.Replace("https://", "").Replace("http://", "")/j/ABC-123</code>) and a countdown on the phone remote.</text>
                        }
                        else
                        {
                            <text>This deck is <strong>@d.Visibility</strong>: the plain link only works for people who already have access. <strong>Go live</strong> below and you get a join link and a short code that admit the whole room without sign-in, for as long as the session runs.</text>
                        }
                    </p>
                    @if (plainWorksForRoom)
                    {
                        <div class="row" style="align-items:flex-start; gap:1.25rem; flex-wrap:wrap">
                            <a href="/d/@d.Slug/qr.svg" target="_blank" rel="noopener" title="Open the QR code full-screen for the room"><img class="qr" src="/d/@d.Slug/qr.svg" alt="QR code linking to this deck" width="132" height="132" /></a>
                            <div style="flex:1; min-width:16rem">
                                <div class="url-box"><code>@Model.PublicOrigin/d/@d.Slug/</code><button class="btn btn-sm" data-copy="@Model.PublicOrigin/d/@d.Slug/">Copy</button></div>
                                <div class="row" style="margin-top:.5rem; gap:.4rem; flex-wrap:wrap">
                                    <button class="btn btn-sm" data-share-url="@Model.PublicOrigin/d/@d.Slug/" data-share-title="@d.Title" data-share-text="Follow along: @Model.PublicOrigin/d/@d.Slug/">Share…</button>
                                    <a class="btn btn-sm" href="mailto:?subject=@Uri.EscapeDataString(d.Title)&body=@Uri.EscapeDataString($"Follow along: {Model.PublicOrigin}/d/{d.Slug}/")">Email</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                @if (d.Kind == DeckKind.Slidev)
                {
                    <p class="hint" style="margin:.6rem 0 0"><strong style="color:var(--text)">Phone remote:</strong> <a href="/d/@(d.Slug)/remote" target="_blank" rel="noopener">/d/@(d.Slug)/remote</a> &mdash; notes, go-to grid, blackout, countdown, Go live; drives every open instance of the deck.</p>
                }
            </div>
        }
        @if (d.Kind == DeckKind.Slidev && servable)
        {
            <div style="margin-top:1rem; padding-top:.9rem; border-top:1px solid var(--border)" id="session-panel">
                @if (Model.LiveSession is { } live)
                {
                    <div class="row" style="align-items:center; gap:.6rem">
                        <span class="badge badge-live">● Live</span>
                        <strong>Session running</strong>
                        <span class="faint">since <time datetime="@live.StartedAt.UtcDateTime.ToString("o")">@live.StartedAt.ToString("HH:mm")</time>@(live.PlannedMinutes is { } pm ? $", planned {pm} min" : "")@(live.HoldDeploys ? ", holding deployments" : "")</span>
                    </div>
                    <p class="hint" style="margin:.4rem 0 0">The join code, link and QR for the room are above under <em>Let the room follow along</em>; the phone remote shows the countdown.</p>
                    <div class="row" style="margin-top:.6rem">
                        <button class="btn btn-primary btn-sm" id="session-end">End session</button>
                        <label class="row" style="gap:.3rem; font-size:.85rem"><input type="checkbox" id="session-unfreeze" checked /> unfreeze the deck when ending</label>
                    </div>
                }
                else
                {
                    <strong>Go live</strong>
                    <p class="hint" style="margin:.2rem 0 .6rem">Freezes the served version for the talk, gives the room a join link and short code (no sign-in needed), puts a countdown on the phone remote and records pacing per slide for the recap. Ends by itself if no presenter is connected for 15 minutes. You can also go live from the phone remote.</p>
                    <div class="row" style="gap:.6rem; flex-wrap:wrap; align-items:center">
                        <label class="row" style="gap:.3rem; font-size:.85rem">Planned <input class="input" id="session-minutes" type="number" min="1" max="600" value="45" style="width:5rem" /> min</label>
                        <label class="row" style="gap:.3rem; font-size:.85rem"><input type="checkbox" id="session-freeze" checked /> freeze deck</label>
                        <label class="row" style="gap:.3rem; font-size:.85rem" title="Pushes to Podium itself wait until this session ends (max 45 min); deck builds are never affected"><input type="checkbox" id="session-hold" @(d.HoldDeploysWhileLive ? "checked" : "") /> hold Podium deployments</label>
                        <button class="btn btn-primary btn-sm" id="session-start">Go live</button>
                    </div>
                }
            </div>
        }
        <div style="margin-top:.75rem" class="row">
            @if (Model.CurrentBuild?.HasPdf == true)
            {
                <a class="btn btn-sm" href="/d/@(d.Slug).pdf" target="_blank" rel="noopener">Open PDF</a>
                <a class="btn btn-sm" href="/d/@(d.Slug).pdf?download=1">Download PDF</a>
            }
            @if (Model.CurrentBuild?.HasPptx == true)
            {
                <a class="btn btn-sm" href="/d/@(d.Slug).pptx">Download PPTX</a>
            }
            @if (Model.CurrentBuild is { HasPdf: false, HasPptx: false })
            {
                <span class="faint" style="font-size:.85rem">No exports in the current build.</span>
            }
        </div>
    </section>

    @if (d.Kind == DeckKind.PowerPoint)
    {
    <section class="panel">
        <h3>Viewer</h3>
        <p class="hint">How the deck is shown when opened in the browser. The original file is always available for download.</p>
        <div class="seg" role="radiogroup" aria-label="PowerPoint viewer">
            <input type="radio" name="pptxViewer" id="pptxViewer-Pdf" value="Pdf" @(d.PptxViewer == PptxViewer.Pdf ? "checked" : "") data-pptx-viewer />
            <label for="pptxViewer-Pdf">PDF rendition</label>
            <input type="radio" name="pptxViewer" id="pptxViewer-Office" value="Office" @(d.PptxViewer == PptxViewer.Office ? "checked" : "") data-pptx-viewer />
            <label for="pptxViewer-Office">PowerPoint Online</label>
        </div>
        <p class="faint" style="margin-top:.6rem; font-size:.85rem">
            <strong>PDF rendition</strong>: made by LibreOffice (or your committed PDF); nothing leaves Podium; animations are lost.<br />
            <strong>PowerPoint Online</strong>: faithful rendering by Microsoft's Office viewer. Microsoft's service downloads the file through a 20-minute signed link each time the deck is opened. Files over ~10 MB may be refused by the viewer.
        </p>
    </section>
    }
    <section class="panel" @(isDoc || d.Kind == DeckKind.Static ? "hidden" : "")>
        <h3>Exports</h3>
        <p class="hint">Generated on every build by the Slidev exporter (headless Chromium).</p>
        <label class="row" style="gap:.5rem"><input type="checkbox" id="exportPdf" @(d.ExportPdf ? "checked" : "") /> Export PDF</label>
        <label class="row" style="gap:.5rem; margin-top:.4rem"><input type="checkbox" id="exportPptx" @(d.ExportPptx ? "checked" : "") /> Export PowerPoint (PPTX)</label>
        @if (d.Kind == DeckKind.Slidev)
        {
            <label class="row" style="gap:.5rem; margin-top:.4rem"><input type="checkbox" id="stripNotes" @(d.StripNotesForViewers ? "checked" : "") /> Hide speaker notes from viewers</label>
            <p class="faint" style="margin:.2rem 0 0 1.6rem; font-size:.82rem">Builds a second copy without notes for everyone except you and people granted <em>Present</em>. Notes are otherwise part of the deck bundle and visible in its presenter view.@(d.StripNotesForViewers && !d.CurrentHasPublicSite ? " The current build has no notes-free copy yet; rebuild to apply." : "")</p>
        }
        <label class="row" style="gap:.5rem; margin-top:.4rem"><input type="checkbox" id="allowEmbedding" @(d.AllowEmbedding ? "checked" : "") /> Allow embedding in other sites</label>
        <p class="faint" style="margin:.2rem 0 0 1.6rem; font-size:.82rem">Only effective while the deck is <strong>Public</strong>. Snippet: <code>&lt;iframe src="@Model.Origin/d/@(d.Slug)/" width="960" height="540" allowfullscreen&gt;&lt;/iframe&gt;</code></p>
        <label class="row" style="gap:.5rem; margin-top:.4rem"><input type="checkbox" id="offlineCache" @(d.OfflineCache ? "checked" : "") /> Offline cache</label>
        <p class="faint" style="margin:.2rem 0 0 1.6rem; font-size:.82rem">A service worker keeps the deck available if the venue network drops: your browsers precache the whole build, viewers cache what they visit. Applies on the next page load.</p>
        <p class="faint" style="margin-top:.6rem; font-size:.85rem">Export changes apply to the next build.</p>
    </section>
</div>

<section class="panel" style="margin-top:1rem">
    <h3>Who can see this</h3>
    <p class="hint"><strong>Private</strong>: only you. <strong>Link</strong>: anyone holding a share link you create below. <strong>Shared</strong>: the GitHub users you list. <strong>Public</strong>: anyone, no sign-in. Each artifact is controlled separately.</p>
    <div class="table-wrap"><table class="table">
        <thead><tr><th>Artifact</th><th>Visibility</th></tr></thead>
        <tbody>
            @foreach (var (label, field, value) in new[] { ("Deck (site)", "visibility", d.Visibility), ("PDF", "pdfVisibility", d.PdfVisibility), ("PPTX", "pptxVisibility", d.PptxVisibility) })
            {
                <tr>
                    <td style="width:9rem">@label</td>
                    <td>
                        <div class="seg" role="radiogroup" aria-label="@label visibility">
                            @foreach (var v in new[] { Visibility.Private, Visibility.Link, Visibility.Shared, Visibility.Public })
                            {
                                var id = $"{field}-{v}";
                                <input type="radio" name="@field" id="@id" value="@v" @(value == v ? "checked" : "") data-vis-field="@field" />
                                <label for="@id">@VisName(v)</label>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
</section>

@if (Model.PendingRequests.Count > 0)
{
<section class="panel" style="margin-top:1rem" id="access-requests">
    <h3>Access requests</h3>
    <p class="hint">Signed-in visitors who asked to see this deck. Approving adds them under <em>People with access</em>.</p>
    <div class="table-wrap"><table class="table">
        <thead><tr><th>Who</th><th>Message</th><th>When</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model.PendingRequests)
        {
            <tr data-request="@r.Principal">
                <td>@(r.DisplayName ?? r.Principal) <span class="faint mono" style="font-size:.78rem">@r.Principal</span></td>
                <td>@(r.Message ?? "-")</td>
                <td><time datetime="@r.RequestedAt.UtcDateTime.ToString("o")">@r.RequestedAt.ToString("g")</time></td>
                <td class="row" style="gap:.3rem; justify-content:flex-end">
                    <label class="row" style="gap:.2rem; font-size:.8rem"><input type="checkbox" data-req-pdf /> PDF</label>
                    <label class="row" style="gap:.2rem; font-size:.8rem"><input type="checkbox" data-req-present /> Present</label>
                    <button class="btn btn-primary btn-sm" data-decide="grant">Approve</button>
                    <button class="btn btn-ghost btn-sm" data-decide="decline">Decline</button>
                </td>
            </tr>
        }
        </tbody>
    </table></div>
</section>
}

<div class="two-col" style="margin-top:1rem">
    <section class="panel">
        <h3>People with access</h3>
        <p class="hint">Applies when an artifact is set to <strong>Shared</strong>. People sign in with GitHub.</p>
        <div class="table-wrap"><table class="table" id="grants">
            <thead><tr><th>GitHub user</th><th>Deck</th><th>PDF</th><th>PPTX</th><th title="Presenter view with notes; may drive the live sync">Present</th><th></th></tr></thead>
            <tbody>
                @foreach (var g in Model.Grants)
                {
                    <tr data-principal="@g.Principal">
                        <td>@(g.DisplayName ?? g.Principal)</td>
                        <td>@(g.Site ? "✓" : "–")</td><td>@(g.Pdf ? "✓" : "–")</td><td>@(g.Pptx ? "✓" : "–")</td><td>@(g.Present ? "✓" : "–")</td>
                        <td><button class="btn btn-ghost btn-sm" data-revoke-grant="@g.Principal">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table></div>
        <form id="grant-form" class="row" style="margin-top:.75rem">
            <input class="input" id="grant-login" placeholder="github-login" style="max-width:14rem" required />
            <label class="row" style="gap:.3rem"><input type="checkbox" id="grant-site" checked /> Deck</label>
            <label class="row" style="gap:.3rem"><input type="checkbox" id="grant-pdf" /> PDF</label>
            <label class="row" style="gap:.3rem"><input type="checkbox" id="grant-pptx" /> PPTX</label>
            <label class="row" style="gap:.3rem" title="Co-presenter: presenter view with notes, may drive the live sync"><input type="checkbox" id="grant-present" /> Present</label>
            <button class="btn btn-sm" type="submit">Add</button>
        </form>
    </section>

    <section class="panel">
        <h3>Share links</h3>
        <p class="hint">Unguessable URLs that work for anyone holding them, even when the artifact is Private. Revocable at any time.</p>
        <div class="table-wrap"><table class="table" id="links">
            <thead><tr><th>Label</th><th>For</th><th>Expires</th><th title="Browsers admitted through this link">Opened</th><th></th></tr></thead>
            <tbody>
                @foreach (var l in Model.Links.Where(l => !l.Revoked))
                {
                    var path = l.Artifact == ArtifactKind.Site ? $"/d/{d.Slug}/" : $"/d/{d.Slug}.{l.Artifact.ToString().ToLowerInvariant()}";
                    var url = $"{Model.Origin}{path}?share={l.Id}";
                    var exhausted = l.MaxUses is { } mu && l.Opens >= mu;
                    <tr data-link="@l.Id" class="@(exhausted ? "faint" : "")">
                        <td>@(l.Label ?? "-")@(l.PasscodeHash is not null ? " (passcode)" : "")@(l.SessionId is not null ? " (session)" : "")</td>
                        <td>@l.Artifact</td>
                        <td>@(l.ExpiresAt is { } e ? e.ToString("yyyy-MM-dd") : "never")</td>
                        <td title="@(l.LastOpenedAt is { } lo ? $"last {lo:yyyy-MM-dd HH:mm}" : "never opened")">@l.Opens@(l.MaxUses is { } max ? $" / {max}" : "")@(exhausted ? " (used up)" : "")</td>
                        <td class="row" style="gap:.3rem">
                            <button class="btn btn-sm" data-copy="@url">Copy</button>
                            <button class="btn btn-ghost btn-sm" data-revoke-link="@l.Id">Revoke</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
        <form id="link-form" class="row" style="margin-top:.75rem">
            <input class="input" id="link-label" placeholder="Label (optional)" style="max-width:12rem" />
            <select class="input" id="link-artifact" style="max-width:8rem">
                <option value="Site">Deck</option>
                <option value="Pdf">PDF</option>
                <option value="Pptx">PPTX</option>
            </select>
            <select class="input" id="link-expiry" style="max-width:9rem">
                <option value="">Never expires</option>
                <option value="1">1 day</option>
                <option value="7" selected>7 days</option>
                <option value="30">30 days</option>
                <option value="365">1 year</option>
            </select>
            <input class="input" id="link-passcode" type="text" placeholder="Passcode (optional)" style="max-width:11rem" maxlength="200" autocomplete="off" />
            <input class="input" id="link-maxuses" type="number" min="1" max="100000" placeholder="Max opens" style="max-width:7rem" />
            <button class="btn btn-sm" type="submit">Create link</button>
        </form>
        <p class="faint" style="font-size:.8rem; margin:.4rem 0 0">A passcode must be entered once per browser; "max opens" caps how many browsers may be admitted. Share the passcode through another channel than the link.</p>
        <div id="new-link" class="url-box hidden" style="margin-top:.6rem"></div>
    </section>
</div>

@if (d.CurrentHasSlideSheet && d.CurrentSlideCount > 0 && servable)
{
<section class="panel" style="margin-top:1rem">
    <h3>Slides</h3>
    <p class="hint">Click a slide to copy a link that opens the deck right there.</p>
    <div class="slide-strip" id="slide-strip" data-count="@d.CurrentSlideCount" data-sheet="/d/@(d.Slug)/slides.jpg?v=@d.CurrentBuildId" data-meta="/d/@(d.Slug)/slides.json?v=@d.CurrentBuildId" data-base="@Model.Origin/d/@(d.Slug)/"></div>
</section>
}

@if (Model.Sessions.Any(s => s.EndedAt is not null))
{
<section class="panel" style="margin-top:1rem">
    <h3>Sessions</h3>
    <p class="hint">Pacing from past live sessions: how long each slide was on screen (summed over revisits).</p>
    @foreach (var s in Model.Sessions.Where(s => s.Recap is not null).Take(5))
    {
        var r = s.Recap!;
        var max = Math.Max(1, r.SecondsPerSlide.Values.DefaultIfEmpty(1).Max());
        <details style="margin-bottom:.6rem" @(s == Model.Sessions.First(x => x.Recap is not null) ? "open" : null)>
            <summary><strong>@s.StartedAt.ToString("yyyy-MM-dd HH:mm")</strong> <span class="faint">· @TimeSpan.FromSeconds(r.DurationSeconds).ToString(r.DurationSeconds >= 3600 ? @"h\:mm\:ss" : @"m\:ss")@(s.PlannedMinutes is { } pm ? $" of {pm} min planned" : "") · peak @r.PeakViewers viewer@(r.PeakViewers == 1 ? "" : "s") · @r.SlidesVisited slide@(r.SlidesVisited == 1 ? "" : "s") visited · ended: @s.EndReason</span></summary>
            @if (r.SecondsPerSlide.Count > 0)
            {
                <div class="session-bars" style="margin-top:.5rem">
                @foreach (var kv in r.SecondsPerSlide.OrderBy(k => k.Key))
                {
                    <span class="mono faint">@kv.Key</span>
                    <div class="bar" style="width:@(Math.Max(1, kv.Value * 100 / max))%" title="@kv.Value s"></div>
                    <span class="mono">@TimeSpan.FromSeconds(kv.Value).ToString(@"m\:ss")</span>
                }
                </div>
            }
        </details>
    }
</section>
}

@if (Model.Activity.Count > 0)
{
<section class="panel" style="margin-top:1rem">
    <h3>Activity</h3>
    <p class="hint">Changes made to this deck through Podium (visibility, grants, links, sessions, rebuilds). <a href="/activity">All activity</a></p>
    <div class="table-wrap"><table class="table">
        <thead><tr><th>When</th><th>Who</th><th>What</th><th>Details</th></tr></thead>
        <tbody>
        @foreach (var a in Model.Activity)
        {
            <tr>
                <td><time datetime="@a.At.UtcDateTime.ToString("o")">@a.At.ToString("g")</time></td>
                <td class="mono">@a.Actor</td>
                <td class="mono">@a.Action</td>
                <td class="faint" style="font-size:.8rem; max-width:28rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap" title="@a.Details">@a.Details</td>
            </tr>
        }
        </tbody>
    </table></div>
</section>
}

<section class="panel" style="margin-top:1rem">
    <h3>Views</h3>
    <p class="hint">One view per person per deck per 10 minutes; your own views are included. Anonymous public viewers appear as one entry.</p>
    <div class="row" style="gap:2rem; margin-bottom:.75rem">
        <div><div class="faint" style="font-size:.78rem; text-transform:uppercase; letter-spacing:.05em">Last 7 days</div><div style="font-size:1.6rem; font-weight:700">@Model.Views7d</div></div>
        <div><div class="faint" style="font-size:.78rem; text-transform:uppercase; letter-spacing:.05em">Last 30 days</div><div style="font-size:1.6rem; font-weight:700">@Model.Views30d</div></div>
        <div><div class="faint" style="font-size:.78rem; text-transform:uppercase; letter-spacing:.05em">Distinct viewers (30d)</div><div style="font-size:1.6rem; font-weight:700">@Model.DistinctViewers30d</div></div>
    </div>
    @if (Model.RecentViews.Count > 0)
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>When</th><th>Who</th><th>What</th></tr></thead>
            <tbody>
            @foreach (var v in Model.RecentViews.Take(12))
            {
                <tr>
                    <td><time datetime="@v.At.UtcDateTime.ToString("o")">@v.At.ToString("g")</time></td>
                    <td class="mono">@(v.Principal == "anonymous" ? "anonymous (public/link)" : v.Principal)</td>
                    <td>@(v.Presenter ? "presenter view" : v.Artifact.ToString().ToLowerInvariant())</td>
                </tr>
            }
            </tbody>
        </table></div>
    }
    else { <p class="faint">No views recorded yet.</p> }
</section>

<section class="panel" style="margin-top:1rem">
    <h3>Builds</h3>
    <div class="table-wrap"><table class="table">
        <thead><tr><th>Build</th><th>Commit</th><th>Status</th><th>Started</th><th>Duration</th><th>Artifacts</th><th>Trigger</th><th></th></tr></thead>
        <caption class="faint" style="caption-side:bottom; text-align:left; padding-top:.5rem; font-size:.8rem">★ served now &nbsp; ❄ frozen on &nbsp; Artifacts of older builds are removed automatically; the served build and one rollback build are always kept.</caption>
        <tbody>
        @foreach (var b in Model.Builds)
        {
            var dur = b.StartedAt is { } s && b.FinishedAt is { } f ? (f - s) : (TimeSpan?)null;
            <tr>
                <td class="mono">@b.Id.Substring(0, Math.Min(14, b.Id.Length))@(b.Id == d.CurrentBuildId ? " ★" : "")@(b.Id == d.PinnedBuildId ? " ❄" : "")</td>
                <td class="mono">@if (Model.Source is not null) { <a href="https://github.com/@Model.Source.FullName/commit/@b.Sha" rel="noreferrer" target="_blank">@b.Sha[..7]</a> } else { @b.Sha[..7] }</td>
                <td>
                    <span class="dot @(b.Status switch { BuildStatus.Succeeded => "dot-ok", BuildStatus.Failed => "dot-bad", BuildStatus.Running or BuildStatus.Queued => "dot-busy", _ => "" })"></span>
                    @b.Status
                    @if (b.Error is not null) { <div class="faint" style="font-size:.8rem">@b.Error</div> }
                </td>
                <td>@if (b.StartedAt is { } st) { <time datetime="@st.UtcDateTime.ToString("o")">@st.ToString("g")</time> } else { <span class="faint">—</span> }</td>
                <td>@(dur is { } dd ? $"{(int)dd.TotalMinutes}m {dd.Seconds:00}s" : "—")</td>
                <td>@(string.Join(" ", new[] { b.HasSite ? "site" : null, b.HasPdf ? "pdf" : null, b.HasPptx ? "pptx" : null }.Where(x => x is not null)))</td>
                <td class="muted">@b.TriggeredBy</td>
                <td class="row" style="gap:.3rem; justify-content:flex-end">
                    @if (b.Status == BuildStatus.Succeeded && b.HasSite && b.Id != d.CurrentBuildId)
                    {
                        <button class="btn btn-sm" data-serve="@b.Id" title="Serve this build (rollback / promote)">Serve</button>
                    }
                    <button class="btn btn-ghost btn-sm" data-log="@b.Id">Log</button>
                </td>
            </tr>
            <tr class="hidden" data-log-row="@b.Id"><td colspan="8"><pre class="log">Loading…</pre></td></tr>
        }
        </tbody>
    </table></div>
</section>

@section Scripts {
<script nonce="@Podium.Web.Security.Csp.Nonce(HttpContext)">
(function () {
  const slug = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.Slug));
  const { api, toast } = Podium;

  async function patch(body, okMsg) {
    try { await api('PATCH', `/api/decks/${slug}`, body); toast(okMsg || 'Saved', 'ok'); }
    catch (e) { toast(e.message, 'error'); }
  }

  document.querySelectorAll('[data-vis-field]').forEach((r) => r.addEventListener('change', () => {
    const body = {}; body[r.dataset.visField] = r.value; patch(body, `Set to ${r.value}`);
  }));
  document.querySelectorAll('[data-pptx-viewer]').forEach((r) => r.addEventListener('change', () => patch({ pptxViewer: r.value }, `Viewer: ${r.value === 'Office' ? 'PowerPoint Online' : 'PDF'}`)));
  document.getElementById('exportPdf').addEventListener('change', (e) => patch({ exportPdf: e.target.checked }));
  document.getElementById('exportPptx').addEventListener('change', (e) => patch({ exportPptx: e.target.checked }));
  document.getElementById('allowEmbedding')?.addEventListener('change', (e) => patch({ allowEmbedding: e.target.checked }, e.target.checked ? 'Embedding allowed for Public decks' : 'Embedding disabled'));
  document.getElementById('offlineCache')?.addEventListener('change', (e) => patch({ offlineCache: e.target.checked }, e.target.checked ? 'Offline cache on' : 'Offline cache off (existing caches clear on the next visit)'));
  document.getElementById('stripNotes')?.addEventListener('change', (e) => patch({ stripNotesForViewers: e.target.checked }, e.target.checked ? 'Viewers will get a notes-free copy from the next build' : 'Viewers will see the full build'));

  const pin = document.getElementById('pin');
  pin.addEventListener('click', async () => {
    const next = pin.getAttribute('aria-pressed') !== 'true';
    await patch({ pinned: next }, next ? 'Pinned' : 'Unpinned');
    pin.setAttribute('aria-pressed', String(next)); pin.textContent = next ? 'Unpin' : 'Pin';
  });

  // Slide strip: every slide as a tile cut from the sheet; click copies a deep link (/d/<slug>/<n>).
  const strip = document.getElementById('slide-strip');
  if (strip) {
    fetch(strip.dataset.meta, { credentials: 'same-origin' }).then((r) => r.ok ? r.json() : null).then((m) => {
      if (!m) return;
      for (let i = 0; i < m.count; i++) {
        const tile = document.createElement('button');
        tile.type = 'button'; tile.className = 'slide-tile'; tile.title = `Copy link to slide ${i + 1}`;
        tile.setAttribute('data-copy', `${strip.dataset.base}${i + 1}`);
        const img = document.createElement('div'); img.className = 'thumb';
        img.style.backgroundImage = `url("${strip.dataset.sheet}")`;
        img.style.backgroundSize = `${m.cols * 100}% auto`;
        img.style.backgroundPosition = `${m.cols > 1 ? ((i % m.cols) / (m.cols - 1)) * 100 : 0}% ${m.rows > 1 ? (Math.floor(i / m.cols) / (m.rows - 1)) * 100 : 0}%`;
        const n = document.createElement('span'); n.className = 'n'; n.textContent = String(i + 1);
        tile.append(img, n);
        strip.appendChild(tile);
      }
    }).catch(() => {});
  }

  document.querySelectorAll('[data-decide]').forEach((b) => b.addEventListener('click', async () => {
    const row = b.closest('tr');
    const grant = b.dataset.decide === 'grant';
    try {
      await api('POST', `/api/decks/${slug}/access-requests/${encodeURIComponent(row.dataset.request)}/decide`, { grant, pdf: row.querySelector('[data-req-pdf]').checked, present: row.querySelector('[data-req-present]').checked });
      toast(grant ? 'Access granted' : 'Request declined', 'ok'); setTimeout(() => location.reload(), 500);
    } catch (e) { toast(e.message, 'error'); }
  }));

  document.getElementById('session-start')?.addEventListener('click', async () => {
    const minutes = Number(document.getElementById('session-minutes').value) || null;
    try {
      const r = await api('POST', `/api/decks/${slug}/sessions`, { plannedMinutes: minutes, holdDeploys: document.getElementById('session-hold').checked, freeze: document.getElementById('session-freeze').checked });
      toast('Live. Share the join link with the room.', 'ok'); setTimeout(() => location.reload(), 500);
    } catch (e) { toast(e.message, 'error'); }
  });
  document.getElementById('session-end')?.addEventListener('click', async () => {
    const unfreeze = document.getElementById('session-unfreeze').checked;
    try { await api('POST', `/api/decks/${slug}/sessions/end?unfreeze=${unfreeze}`); toast('Session ended', 'ok'); setTimeout(() => location.reload(), 500); }
    catch (e) { toast(e.message, 'error'); }
  });

  document.getElementById('alias-save').addEventListener('click', async () => {
    try { const r = await api('PATCH', `/api/decks/${slug}`, { alias: document.getElementById('alias').value }); toast(r.alias ? `Alias: /d/${r.alias}/` : 'Alias removed', 'ok'); setTimeout(() => location.reload(), 600); }
    catch (e) { toast(e.message, 'error'); }
  });
  document.getElementById('tags-save').addEventListener('click', async () => {
    const tags = document.getElementById('tags').value.split(',').map((t) => t.trim()).filter(Boolean);
    try { const r = await api('PATCH', `/api/decks/${slug}`, { tags }); toast(`Tags saved (${r.tags.length})`, 'ok'); }
    catch (e) { toast(e.message, 'error'); }
  });

  const freezeBtn = document.getElementById('freeze');
  freezeBtn.addEventListener('click', async () => {
    const next = freezeBtn.getAttribute('aria-pressed') !== 'true';
    freezeBtn.disabled = true;
    try { await api('POST', `/api/decks/${slug}/freeze?frozen=${next}`); toast(next ? 'Frozen on the current build' : 'Unfrozen', 'ok'); location.reload(); }
    catch (err) { toast(err.message, 'error'); freezeBtn.disabled = false; }
  });

  document.getElementById('rebuild').addEventListener('click', async (e) => {
    e.target.disabled = true; e.target.textContent = 'Queuing…';
    try { await api('POST', `/api/decks/${slug}/rebuild`); toast('Build queued', 'ok'); setTimeout(() => location.reload(), 1200); }
    catch (err) { toast(err.message, 'error'); e.target.disabled = false; e.target.textContent = 'Rebuild'; }
  });

  document.getElementById('grant-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const login = document.getElementById('grant-login').value.trim();
    try {
      await api('POST', `/api/decks/${slug}/grants`, { login, site: grantSite.checked, pdf: grantPdf.checked, pptx: grantPptx.checked, present: document.getElementById('grant-present').checked });
      toast(`Added ${login}`, 'ok'); location.reload();
    } catch (err) { toast(err.message, 'error'); }
  });
  const grantSite = document.getElementById('grant-site'), grantPdf = document.getElementById('grant-pdf'), grantPptx = document.getElementById('grant-pptx');

  document.addEventListener('click', async (e) => {
    const g = e.target.closest('[data-revoke-grant]');
    if (g) { try { await api('DELETE', `/api/decks/${slug}/grants/${encodeURIComponent(g.dataset.revokeGrant)}`); g.closest('tr').remove(); toast('Removed', 'ok'); } catch (err) { toast(err.message, 'error'); } }
    const l = e.target.closest('[data-revoke-link]');
    if (l) { try { await api('POST', `/api/decks/${slug}/links/${l.dataset.revokeLink}/revoke`); l.closest('tr').remove(); toast('Link revoked', 'ok'); } catch (err) { toast(err.message, 'error'); } }
    const sv = e.target.closest('[data-serve]');
    if (sv) {
      // While frozen, serving another build moves the freeze onto it; otherwise it is a plain rollback/promote that the
      // next successful build will replace again.
      const frozen = @(d.PinnedBuildId is not null ? "true" : "false");
      if (!confirm(frozen ? 'Serve this build and keep the deck frozen on it?' : 'Serve this build now? The next successful build will replace it again.')) return;
      sv.disabled = true;
      try { await api('POST', `/api/decks/${slug}/builds/${sv.dataset.serve}/serve?freeze=${frozen}`); toast('Now serving that build', 'ok'); location.reload(); }
      catch (err) { toast(err.message, 'error'); sv.disabled = false; }
    }
    const lg = e.target.closest('[data-log]');
    if (lg) {
      const row = document.querySelector(`[data-log-row="${lg.dataset.log}"]`);
      row.classList.toggle('hidden');
      if (!row.classList.contains('hidden') && !row.dataset.loaded) {
        row.dataset.loaded = '1';
        try {
          const res = await fetch(`/api/decks/${slug}/builds/${lg.dataset.log}/log`, { headers: { 'X-Podium-Request': '1' } });
          row.querySelector('pre').textContent = res.ok ? await res.text() : `No log available (HTTP ${res.status})`;
        } catch { row.querySelector('pre').textContent = 'Failed to load log'; }
      }
    }
  });

  document.getElementById('link-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const expiry = document.getElementById('link-expiry').value;
    try {
      const maxUses = Number(document.getElementById('link-maxuses').value) || null;
      const r = await api('POST', `/api/decks/${slug}/links`, { artifact: document.getElementById('link-artifact').value, expiresInDays: expiry ? Number(expiry) : null, label: document.getElementById('link-label').value || null, passcode: document.getElementById('link-passcode').value || null, maxUses });
      document.getElementById('link-passcode').value = '';
      const box = document.getElementById('new-link');
      box.classList.remove('hidden');
      box.innerHTML = '';
      const code = document.createElement('code'); code.textContent = r.url;
      const btn = document.createElement('button'); btn.className = 'btn btn-sm'; btn.textContent = 'Copy'; btn.setAttribute('data-copy', r.url);
      box.append(code, btn);
      toast('Link created — copy it now', 'ok');
    } catch (err) { toast(err.message, 'error'); }
  });

  @if (building)
  {
    <text>
    (async function watch() {
      try { const r = await api('GET', `/api/decks/${slug}`); const s = r.deck.latestBuildStatus; if (s === 'Queued' || s === 'Running') setTimeout(watch, 5000); else location.reload(); }
      catch { setTimeout(watch, 10000); }
    })();
    </text>
  }
})();
</script>
}
