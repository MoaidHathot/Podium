@page
@model Podium.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Library";
}

<div class="row-between" style="margin-bottom: 1rem">
    <div>
        <h1>Library</h1>
        <p class="muted" style="margin:0">@Model.Decks.Count deck@(Model.Decks.Count == 1 ? "" : "s") across @Model.Sources.Count repositor@(Model.Sources.Count == 1 ? "y" : "ies")</p>
    </div>
    <a class="btn" href="/sources">Manage sources</a>
</div>

@if (!Model.HasSources)
{
    <div class="empty section">
        <h3>No repositories connected yet</h3>
        <p>Install the Podium GitHub App on the repositories that hold your slides, or add a public repository.</p>
        <a class="btn btn-primary" href="/sources">Connect a repository</a>
    </div>
}
else if (Model.Decks.Count == 0)
{
    <div class="empty section">
        <h3>No decks found yet</h3>
        <p>Repositories are scanned for <code>slides.md</code> (Slidev), presenterm decks, <code>.pptx</code> and <code>.pdf</code> files, and committed HTML exports. If you just connected a repo, the first scan may still be running.</p>
        <a class="btn" href="/sources">View sources</a>
    </div>
}
else
{
    <div class="toolbar" role="toolbar" aria-label="Library controls">
        <div class="search-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input id="search" class="input" type="search" placeholder="Search title, repo, path, tag…" autocomplete="off" aria-label="Search decks" />
            <kbd>/</kbd>
        </div>
        <label class="control">Group by
            <select id="group" class="input">
                <option value="repo">Repository</option>
                <option value="kind">Type</option>
                <option value="vis">Visibility</option>
                <option value="year">Year</option>
                <option value="none">Nothing</option>
            </select>
        </label>
        <label class="control">Sort
            <select id="sort" class="input">
                <option value="updated">Recently updated</option>
                <option value="viewed">Recently presented</option>
                <option value="title">Title A–Z</option>
                <option value="status">Needs attention</option>
            </select>
        </label>
        <div class="seg density" role="radiogroup" aria-label="Density">
            <input type="radio" name="density" id="density-grid" value="grid" checked /><label for="density-grid" title="Grid with thumbnails">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg><span class="sr-only">Grid</span></label>
            <input type="radio" name="density" id="density-list" value="list" /><label for="density-list" title="Compact list">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="4" width="18" height="3" rx="1.5"/><rect x="3" y="10.5" width="18" height="3" rx="1.5"/><rect x="3" y="17" width="18" height="3" rx="1.5"/></svg><span class="sr-only">List</span></label>
        </div>
    </div>

    <div class="chips" id="filters" role="group" aria-label="Filters">
        <span class="chips-label">Type</span>
        <button class="chip" data-filter="kind" data-value="slidev" aria-pressed="false">Slidev</button>
        <button class="chip" data-filter="kind" data-value="presenterm" aria-pressed="false">presenterm</button>
        <button class="chip" data-filter="kind" data-value="powerpoint" aria-pressed="false">PowerPoint</button>
        <button class="chip" data-filter="kind" data-value="pdf" aria-pressed="false">PDF</button>
        <button class="chip" data-filter="kind" data-value="static" aria-pressed="false">HTML</button>
        <span class="chips-sep"></span>
        <span class="chips-label">Visibility</span>
        <button class="chip" data-filter="vis" data-value="public" aria-pressed="false">Public</button>
        <button class="chip" data-filter="vis" data-value="link" aria-pressed="false">Link</button>
        <button class="chip" data-filter="vis" data-value="shared" aria-pressed="false">Shared</button>
        <button class="chip" data-filter="vis" data-value="private" aria-pressed="false">Private</button>
        <span class="chips-sep"></span>
        <span class="chips-label">Status</span>
        <button class="chip" data-filter="status" data-value="failed" aria-pressed="false">Build failed</button>
        <button class="chip" data-filter="status" data-value="building" aria-pressed="false">Building</button>
        <button class="chip chip-clear hidden" id="clear-filters">Clear</button>
    </div>

    @if (Model.Pinned.Count > 0)
    {
        <section class="section group shelf" data-section="pinned" data-group-key="shelf:pinned">
            <div class="section-head">
                <button class="group-toggle" type="button" aria-expanded="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
                    <h2>Pinned</h2>
                </button>
                <span class="faint count">@Model.Pinned.Count deck@(Model.Pinned.Count == 1 ? "" : "s")</span>
            </div>
            <div class="grid cards-grid">
                @foreach (var r in Model.Pinned) { <partial name="_DeckCard" model="r" /> }
            </div>
        </section>
    }
    <section class="section group shelf @(Model.RecentlyViewed.Count == 0 ? "hidden" : "")" data-section="recent-viewed" data-group-key="shelf:recent" id="recent-shelf">
        <div class="section-head">
            <button class="group-toggle" type="button" aria-expanded="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
                <h2>Recently presented</h2>
            </button>
            <span class="faint count" data-recent-count>@Model.RecentlyViewed.Count deck@(Model.RecentlyViewed.Count == 1 ? "" : "s")</span>
        </div>
        <div class="grid cards-grid">
            @foreach (var r in Model.RecentlyViewed) { <partial name="_DeckCard" model="r" /> }
        </div>
    </section>

    <div id="groups" class="section" aria-live="polite">
        <section class="section group" data-group-key="all">
            <div class="section-head"><h2>All decks</h2><span class="faint count"></span></div>
            <div class="grid cards-grid" id="pool">
                @foreach (var r in Model.Decks) { <partial name="_DeckCard" model="r" /> }
            </div>
        </section>
    </div>
    <div class="empty hidden" id="no-results" style="margin-top:1rem">
        <h3>No matches</h3>
        <p>Try a different search or clear the filters.</p>
    </div>
}

@section Scripts {
<script>
(function () {
  const search = document.getElementById('search');
  if (!search) return;
  const groupSel = document.getElementById('group');
  const sortSel = document.getElementById('sort');
  const densityInputs = [...document.querySelectorAll('input[name="density"]')];
  const chips = [...document.querySelectorAll('#filters .chip[data-filter]')];
  const clearBtn = document.getElementById('clear-filters');
  const groupsRoot = document.getElementById('groups');
  const shelves = [...document.querySelectorAll('section.shelf')];
  const noResults = document.getElementById('no-results');
  // The pool cards are the canonical nodes; grouping moves them between sections.
  const cards = [...document.querySelectorAll('#pool > .card')];

  const KEY = 'podium.library.v1';
  const state = Object.assign({ group: 'repo', sort: 'updated', density: 'grid', collapsed: {}, kind: null, vis: null, status: null }, load());
  function load() { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } }
  function save() { localStorage.setItem(KEY, JSON.stringify({ group: state.group, sort: state.sort, density: state.density, collapsed: state.collapsed })); }

  groupSel.value = state.group; sortSel.value = state.sort;
  densityInputs.forEach((i) => { i.checked = i.value === state.density; });

  const labels = {
    repo: (c) => c.dataset.repo,
    kind: (c) => c.dataset.kindLabel,
    vis: (c) => c.dataset.visLabel,
    year: (c) => c.dataset.year,
  };
  const sorters = {
    updated: (a, b) => (b.dataset.updated || '').localeCompare(a.dataset.updated || ''),
    viewed: (a, b) => (b.dataset.viewed || '').localeCompare(a.dataset.viewed || '') || sorters.updated(a, b),
    title: (a, b) => a.dataset.title.localeCompare(b.dataset.title),
    status: (a, b) => rank(b) - rank(a) || sorters.updated(a, b),
  };
  const rank = (c) => c.dataset.status === 'failed' ? 2 : c.dataset.status === 'building' ? 1 : 0;

  function matches(c) {
    const q = search.value.trim().toLowerCase();
    return (!q || c.dataset.search.includes(q))
      && (!state.kind || c.dataset.kind === state.kind)
      && (!state.vis || c.dataset.vis === state.vis)
      && (!state.status || c.dataset.status === state.status);
  }

  function render() {
    const filtering = search.value.trim().length > 0 || state.kind || state.vis || state.status;
    // Shelves step aside while searching/filtering; an emptied shelf (all recents dismissed) stays hidden.
    shelves.forEach((s) => s.classList.toggle('hidden', !!filtering || s.querySelectorAll('.card').length === 0));
    clearBtn.classList.toggle('hidden', !filtering);
    document.body.dataset.group = state.group;
    document.body.dataset.density = state.density;

    const visible = cards.filter(matches).sort(sorters[state.sort] || sorters.updated);
    const groups = new Map();
    for (const c of visible) {
      const key = state.group === 'none' ? 'All decks' : (labels[state.group](c) || 'Other');
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key).push(c);
    }
    // Groups ordered by their most recent deck (already sorted), except Year which is descending by label.
    const order = [...groups.keys()];
    if (state.group === 'year') order.sort((a, b) => b.localeCompare(a));

    groupsRoot.replaceChildren();
    for (const key of order) {
      const collapsed = !!state.collapsed[state.group + ':' + key] && !filtering;
      const sec = document.createElement('section');
      sec.className = 'section group' + (collapsed ? ' collapsed' : '');
      sec.dataset.groupKey = key;
      const head = document.createElement('div'); head.className = 'section-head';
      const btn = document.createElement('button'); btn.className = 'group-toggle'; btn.type = 'button'; btn.setAttribute('aria-expanded', String(!collapsed));
      btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg><h2></h2>`;
      btn.querySelector('h2').textContent = key;
      const count = document.createElement('span'); count.className = 'faint count'; count.textContent = `${groups.get(key).length} deck${groups.get(key).length === 1 ? '' : 's'}`;
      btn.addEventListener('click', () => { state.collapsed[state.group + ':' + key] = !state.collapsed[state.group + ':' + key]; save(); render(); });
      head.append(btn, count);
      const grid = document.createElement('div'); grid.className = 'grid cards-grid';
      grid.append(...groups.get(key));
      sec.append(head, grid);
      groupsRoot.append(sec);
    }
    noResults.classList.toggle('hidden', visible.length > 0);
  }

  search.addEventListener('input', render);
  groupSel.addEventListener('change', () => { state.group = groupSel.value; save(); render(); });
  sortSel.addEventListener('change', () => { state.sort = sortSel.value; save(); render(); });
  densityInputs.forEach((i) => i.addEventListener('change', () => { if (i.checked) { state.density = i.value; save(); render(); } }));
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const f = chip.dataset.filter, v = chip.dataset.value;
    state[f] = state[f] === v ? null : v;
    chips.forEach((c) => { if (c.dataset.filter === f) c.setAttribute('aria-pressed', String(state[f] === c.dataset.value)); });
    render();
  }));
  clearBtn.addEventListener('click', () => { state.kind = state.vis = state.status = null; search.value = ''; chips.forEach((c) => c.setAttribute('aria-pressed', 'false')); render(); });

  // Shelves (Pinned, Recently presented) are server-rendered but behave like any other group: collapsible, remembered.
  for (const shelf of shelves) {
    const key = shelf.dataset.groupKey;
    const btn = shelf.querySelector('.group-toggle');
    const apply = () => { const collapsed = !!state.collapsed[key]; shelf.classList.toggle('collapsed', collapsed); btn.setAttribute('aria-expanded', String(!collapsed)); };
    btn.addEventListener('click', () => { state.collapsed[key] = !state.collapsed[key]; save(); apply(); });
    apply();
  }

  // Remove a deck from "Recently presented" (it returns the next time it is presented).
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-dismiss-recent]');
    if (!btn) return;
    e.preventDefault();
    const slug = btn.dataset.dismissRecent;
    const card = btn.closest('.card');
    btn.disabled = true;
    try {
      await Podium.api('POST', `/api/recent/${slug}/dismiss`);
      card.remove();
      const shelf = document.getElementById('recent-shelf');
      const left = shelf.querySelectorAll('.card').length;
      shelf.querySelector('[data-recent-count]').textContent = `${left} deck${left === 1 ? '' : 's'}`;
      if (left === 0) shelf.classList.add('hidden');
      Podium.toast('Removed from recently presented', 'ok');
    } catch (err) { btn.disabled = false; Podium.toast(err.message, 'error'); }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== search && !/input|textarea|select/i.test(document.activeElement?.tagName || '')) { e.preventDefault(); search.focus(); search.select(); }
    if (e.key === 'Escape' && document.activeElement === search) { search.value = ''; render(); search.blur(); }
  });
  render();

  // Keep build status fresh while anything is building.
  let polling = @(Model.AnyBuilding ? "true" : "false");
  async function poll() {
    try {
      const decks = await Podium.api('GET', '/api/decks');
      let busy = false;
      for (const d of decks) {
        const els = document.querySelectorAll(`.card[data-slug="${d.slug}"]`);
        const status = d.latestBuildStatus;
        const isBusy = status === 'Queued' || status === 'Running';
        busy = busy || isBusy;
        els.forEach((el) => {
          const dot = el.querySelector('.card-meta .dot');
          if (dot) dot.className = 'dot ' + (status === 'Succeeded' ? 'dot-ok' : status === 'Failed' ? 'dot-bad' : isBusy ? 'dot-busy' : '');
          const label = el.querySelector('[data-status-label]');
          if (label) label.textContent = isBusy ? (status === 'Queued' ? 'Queued' : 'Building') : status === 'Succeeded' ? 'Built' : status === 'Failed' ? (d.currentBuildId ? 'Last build failed (serving previous)' : 'Build failed') : 'Not built';
          el.dataset.status = isBusy ? 'building' : status === 'Failed' ? 'failed' : 'ok';
        });
      }
      if (busy) setTimeout(poll, 5000); else if (polling) { polling = false; location.reload(); }
    } catch { setTimeout(poll, 15000); }
  }
  if (polling) setTimeout(poll, 4000);
})();
</script>
}
