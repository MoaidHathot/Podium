@page
@model Podium.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Library";
}

<div class="row-between" style="margin-bottom: 1rem">
    <div>
        <h1>Library</h1>
        <p class="muted" style="margin:0">@Model.Decks.Count deck@(Model.Decks.Count == 1 ? "" : "s") across @Model.Sources.Count repositor@(Model.Sources.Count == 1 ? "y" : "ies")</p>
    </div>
    <div class="row" style="gap:.5rem">
        @if (Model.Sources.Any(s => s.Trusted))
        {
            <button class="btn btn-primary" id="new-deck">New deck</button>
        }
        <a class="btn" href="/sources">Manage sources</a>
        <button class="btn btn-ghost" id="help-btn" title="Keyboard shortcuts (?)">?</button>
    </div>
</div>

<dialog id="new-deck-dialog" class="dialog">
    <form method="dialog">
        <h3 style="margin-top:0">New deck</h3>
        <p class="hint">Creates the first file in your repository on GitHub, pre-filled with a starter deck and a <code>.podium.yml</code>. Push (or commit on GitHub) and Podium picks it up within a minute.</p>
        <label class="field">Repository
            <select class="input" id="nd-repo">
                @foreach (var s in Model.Sources.Where(s => s.Trusted)) { <option value="@s.FullName" data-ref="@(s.Ref ?? "")">@s.FullName</option> }
            </select>
        </label>
        <label class="field">Folder <span class="faint">(becomes part of the URL)</span><input class="input" id="nd-folder" placeholder="talks/my-next-talk" required pattern="[A-Za-z0-9._\/-]+" maxlength="200" /></label>
        <label class="field">Title<input class="input" id="nd-title" placeholder="My next talk" maxlength="200" /></label>
        <label class="field">Kind
            <select class="input" id="nd-kind"><option value="slidev">Slidev (slides.md)</option><option value="presenterm">presenterm (main.md + config.yaml)</option></select>
        </label>
        <div class="row" style="justify-content:flex-end; gap:.5rem; margin-top:.8rem">
            <button class="btn" value="cancel">Cancel</button>
            <button class="btn btn-primary" value="create" id="nd-create">Open on GitHub</button>
        </div>
    </form>
</dialog>

<dialog id="help-dialog" class="dialog">
    <h3 style="margin-top:0">Keyboard shortcuts</h3>
    <table class="table shortcuts">
        <tbody>
            <tr><td><kbd>/</kbd></td><td>Search decks and slide text</td></tr>
            <tr><td><kbd>Esc</kbd></td><td>Clear search / close dialogs</td></tr>
            <tr><td><kbd>Space</kbd> on a card</td><td>Select for bulk actions (<kbd>Shift</kbd>+click selects a range)</td></tr>
            <tr><td><kbd>?</kbd></td><td>This help</td></tr>
            <tr><td colspan="2" class="faint" style="padding-top:.6rem">In a deck: Slidev's own keys apply. On the phone remote: <kbd>←</kbd> <kbd>→</kbd> <kbd>Space</kbd> navigate, <kbd>B</kbd> blackout, <kbd>G</kbd> go to slide.</td></tr>
            <tr><td colspan="2" class="faint" style="padding-top:.6rem"><strong>On your phone:</strong> install Podium as an app for one-tap access to the remote. Android/Chrome and desktop Edge/Chrome show an <em>Install</em> button in the top bar; on iPhone use Share &rarr; <em>Add to Home Screen</em>.</td></tr>
        </tbody>
    </table>
    <form method="dialog" class="row" style="justify-content:flex-end"><button class="btn">Close</button></form>
</dialog>

<div class="bulkbar hidden" id="bulkbar" role="toolbar" aria-label="Bulk actions">
    <strong id="bulk-count">0 selected</strong>
    <select class="input" id="bulk-vis" aria-label="Set visibility"><option value="">Visibility…</option><option value="Private">Private</option><option value="Link">Link</option><option value="Shared">Shared</option><option value="Public">Public</option></select>
    <input class="input" id="bulk-tags" placeholder="Add tags (comma-separated)" style="max-width:16rem" />
    <button class="btn btn-sm" id="bulk-tags-apply">Add tags</button>
    <button class="btn btn-sm" id="bulk-pin">Pin</button>
    <button class="btn btn-sm" id="bulk-unpin">Unpin</button>
    <button class="btn btn-sm" id="bulk-rebuild">Rebuild</button>
    <button class="btn btn-ghost btn-sm" id="bulk-clear">Clear</button>
</div>

@if (Model.PendingRequests.Count > 0)
{
    <div class="alert alert-info" style="margin-bottom:1rem"><strong>@Model.PendingRequests.Count access request@(Model.PendingRequests.Count == 1 ? "" : "s") waiting:</strong>
        @foreach (var g in Model.PendingRequests.GroupBy(r => r.DeckSlug))
        {
            <a href="/decks/@g.Key#access-requests" style="margin-left:.5rem">@g.Key (@g.Count())</a>
        }
    </div>
}

@if (!Model.HasSources)
{
    <div class="empty section">
        <h3>No repositories connected yet</h3>
        <p>Install the Podium GitHub App on the repositories that hold your slides, or add a public repository.</p>
        <a class="btn btn-primary" href="/sources">Connect a repository</a>
    </div>
}
else if (Model.Decks.Count == 0)
{
    <div class="empty section">
        <h3>No decks found yet</h3>
        <p>Repositories are scanned for <code>slides.md</code> (Slidev), presenterm decks, <code>.pptx</code> and <code>.pdf</code> files, and committed HTML exports. If you just connected a repo, the first scan may still be running.</p>
        <a class="btn" href="/sources">View sources</a>
    </div>
}
else
{
    <div class="toolbar" role="toolbar" aria-label="Library controls">
        <div class="search-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input id="search" class="input" type="search" placeholder="Search title, repo, path, tag…" autocomplete="off" aria-label="Search decks" />
            <kbd>/</kbd>
        </div>
        <label class="control">Group by
            <select id="group" class="input">
                <option value="repo">Repository</option>
                <option value="kind">Type</option>
                <option value="vis">Visibility</option>
                <option value="year">Year</option>
                <option value="none">Nothing</option>
            </select>
        </label>
        <label class="control">Sort
            <select id="sort" class="input">
                <option value="updated">Recently updated</option>
                <option value="viewed">Recently presented</option>
                <option value="title">Title A–Z</option>
                <option value="status">Needs attention</option>
            </select>
        </label>
        <div class="seg density" role="radiogroup" aria-label="Density">
            <input type="radio" name="density" id="density-grid" value="grid" checked /><label for="density-grid" title="Grid with thumbnails">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg><span class="sr-only">Grid</span></label>
            <input type="radio" name="density" id="density-list" value="list" /><label for="density-list" title="Compact list">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="4" width="18" height="3" rx="1.5"/><rect x="3" y="10.5" width="18" height="3" rx="1.5"/><rect x="3" y="17" width="18" height="3" rx="1.5"/></svg><span class="sr-only">List</span></label>
        </div>
    </div>

    <div class="chips" id="filters" role="group" aria-label="Filters">
        <span class="chips-label">Type</span>
        <button class="chip" data-filter="kind" data-value="slidev" aria-pressed="false">Slidev</button>
        <button class="chip" data-filter="kind" data-value="presenterm" aria-pressed="false">presenterm</button>
        <button class="chip" data-filter="kind" data-value="powerpoint" aria-pressed="false">PowerPoint</button>
        <button class="chip" data-filter="kind" data-value="pdf" aria-pressed="false">PDF</button>
        <button class="chip" data-filter="kind" data-value="static" aria-pressed="false">HTML</button>
        <span class="chips-sep"></span>
        <span class="chips-label">Visibility</span>
        <button class="chip" data-filter="vis" data-value="public" aria-pressed="false">Public</button>
        <button class="chip" data-filter="vis" data-value="link" aria-pressed="false">Link</button>
        <button class="chip" data-filter="vis" data-value="shared" aria-pressed="false">Shared</button>
        <button class="chip" data-filter="vis" data-value="private" aria-pressed="false">Private</button>
        <span class="chips-sep"></span>
        <span class="chips-label">Status</span>
        <button class="chip" data-filter="status" data-value="failed" aria-pressed="false">Build failed</button>
        <button class="chip" data-filter="status" data-value="building" aria-pressed="false">Building</button>
        @{ var allTags = Model.Decks.SelectMany(r => r.Deck.Tags).GroupBy(t => t, StringComparer.Ordinal).OrderByDescending(g => g.Count()).ThenBy(g => g.Key, StringComparer.Ordinal).Select(g => g.Key).Take(12).ToList(); }
        @if (allTags.Count > 0)
        {
            <span class="chips-sep"></span>
            <span class="chips-label">Tags</span>
            @foreach (var tag in allTags) { <button class="chip chip-tag" data-filter="tag" data-value="@tag" aria-pressed="false">#@tag</button> }
        }
        <button class="chip chip-clear hidden" id="clear-filters">Clear</button>
    </div>

    @if (Model.Pinned.Count > 0)
    {
        <section class="section group shelf" data-section="pinned" data-group-key="shelf:pinned">
            <div class="section-head">
                <button class="group-toggle" type="button" aria-expanded="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
                    <h2>Pinned</h2>
                </button>
                <span class="faint count">@Model.Pinned.Count deck@(Model.Pinned.Count == 1 ? "" : "s")</span>
            </div>
            <div class="grid cards-grid">
                @foreach (var r in Model.Pinned) { <partial name="_DeckCard" model="r" /> }
            </div>
        </section>
    }
    <section class="section group shelf @(Model.RecentlyViewed.Count == 0 ? "hidden" : "")" data-section="recent-viewed" data-group-key="shelf:recent" id="recent-shelf">
        <div class="section-head">
            <button class="group-toggle" type="button" aria-expanded="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
                <h2>Recently presented</h2>
            </button>
            <span class="faint count" data-recent-count>@Model.RecentlyViewed.Count deck@(Model.RecentlyViewed.Count == 1 ? "" : "s")</span>
        </div>
        <div class="grid cards-grid">
            @foreach (var r in Model.RecentlyViewed) { <partial name="_DeckCard" model="r" /> }
        </div>
    </section>

    <div id="groups" class="section" aria-live="polite">
        <section class="section group" data-group-key="all">
            <div class="section-head"><h2>All decks</h2><span class="faint count"></span></div>
            <div class="grid cards-grid" id="pool">
                @foreach (var r in Model.Decks) { <partial name="_DeckCard" model="r" /> }
            </div>
        </section>
    </div>
    <section class="section hidden" id="slide-hits" aria-live="polite">
        <div class="section-head"><h2>In slides</h2><span class="faint count" id="slide-hits-count"></span></div>
        <ul class="hits" id="slide-hits-list"></ul>
    </section>

    <div class="empty hidden" id="no-results" style="margin-top:1rem">
        <h3>No matches</h3>
        <p>Try a different search or clear the filters.</p>
    </div>

    @if (Model.Archived.Count > 0)
    {
        <section class="section group collapsed" data-group-key="shelf:archived" id="archived">
            <div class="section-head">
                <button class="group-toggle" type="button" aria-expanded="false">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
                    <h2>Archived</h2>
                </button>
                <span class="faint count">@Model.Archived.Count deck@(Model.Archived.Count == 1 ? "" : "s") no longer in their repositories; artifacts are purged after 30 days</span>
            </div>
            <div class="grid cards-grid">
                <div class="table-wrap" style="grid-column:1/-1"><table class="table">
                    <thead><tr><th>Deck</th><th>Repository</th><th>Archived</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.Archived)
                    {
                        <tr data-archived="@r.Deck.Slug">
                            <td><a href="/decks/@r.Deck.Slug">@r.Deck.Title</a> <span class="faint mono" style="font-size:.78rem">@r.Deck.Path</span></td>
                            <td class="mono">@r.RepoLabel</td>
                            <td><time datetime="@r.Deck.UpdatedAt.UtcDateTime.ToString("o")">@r.Deck.UpdatedAt.ToString("yyyy-MM-dd")</time></td>
                            <td style="text-align:right"><button class="btn btn-danger btn-sm" data-delete-deck="@r.Deck.Slug">Delete permanently</button></td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </div>
        </section>
    }
}

@section Scripts {
<script nonce="@Podium.Web.Security.Csp.Nonce(HttpContext)">
(function () {
  const search = document.getElementById('search');
  if (!search) return;
  const groupSel = document.getElementById('group');
  const sortSel = document.getElementById('sort');
  const densityInputs = [...document.querySelectorAll('input[name="density"]')];
  const chips = [...document.querySelectorAll('#filters .chip[data-filter]')];
  const clearBtn = document.getElementById('clear-filters');
  const groupsRoot = document.getElementById('groups');
  const shelves = [...document.querySelectorAll('section.shelf, section#archived')];
  const noResults = document.getElementById('no-results');
  // The pool cards are the canonical nodes; grouping moves them between sections.
  const cards = [...document.querySelectorAll('#pool > .card')];

  const KEY = 'podium.library.v1';
  const state = Object.assign({ group: 'repo', sort: 'updated', density: 'grid', collapsed: {}, kind: null, vis: null, status: null, tag: null }, load());
  function load() { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } }
  function save() { localStorage.setItem(KEY, JSON.stringify({ group: state.group, sort: state.sort, density: state.density, collapsed: state.collapsed })); }

  groupSel.value = state.group; sortSel.value = state.sort;
  densityInputs.forEach((i) => { i.checked = i.value === state.density; });

  const labels = {
    repo: (c) => c.dataset.repo,
    kind: (c) => c.dataset.kindLabel,
    vis: (c) => c.dataset.visLabel,
    year: (c) => c.dataset.year,
  };
  const sorters = {
    updated: (a, b) => (b.dataset.updated || '').localeCompare(a.dataset.updated || ''),
    viewed: (a, b) => (b.dataset.viewed || '').localeCompare(a.dataset.viewed || '') || sorters.updated(a, b),
    title: (a, b) => a.dataset.title.localeCompare(b.dataset.title),
    status: (a, b) => rank(b) - rank(a) || sorters.updated(a, b),
  };
  const rank = (c) => c.dataset.status === 'failed' ? 2 : c.dataset.status === 'building' ? 1 : 0;

  function matches(c) {
    const q = search.value.trim().toLowerCase();
    return (!q || c.dataset.search.includes(q))
      && (!state.kind || c.dataset.kind === state.kind)
      && (!state.vis || c.dataset.vis === state.vis)
      && (!state.status || c.dataset.status === state.status)
      && (!state.tag || (c.dataset.tags || '').split(' ').includes(state.tag));
  }

  // Full-text hits inside slide content (owner API, debounced). Independent of the card filter.
  const hitsSection = document.getElementById('slide-hits'), hitsList = document.getElementById('slide-hits-list'), hitsCount = document.getElementById('slide-hits-count');
  let hitsTimer = null, hitsSeq = 0;
  function searchSlides() {
    const q = search.value.trim();
    clearTimeout(hitsTimer);
    if (q.length < 2) { hitsSection.classList.add('hidden'); hitsList.innerHTML = ''; return; }
    hitsTimer = setTimeout(async () => {
      const seq = ++hitsSeq;
      try {
        const hits = await Podium.api('GET', `/api/search?q=${encodeURIComponent(q)}`);
        if (seq !== hitsSeq) return;
        hitsList.innerHTML = '';
        for (const h of hits) {
          const li = document.createElement('li');
          const a = document.createElement('a'); a.href = `/d/${h.slug}/${h.slide}`; a.target = '_blank'; a.rel = 'noopener';
          const t = document.createElement('strong'); t.textContent = h.title;
          const where = document.createElement('span'); where.className = 'faint'; where.textContent = ` · slide ${h.slide}${h.slideTitle ? ` · ${h.slideTitle}` : ''}`;
          const snip = document.createElement('div'); snip.className = 'muted snippet'; snip.textContent = h.snippet;
          a.append(t, where); li.append(a, snip); hitsList.appendChild(li);
        }
        hitsCount.textContent = hits.length ? `${hits.length} slide${hits.length === 1 ? '' : 's'}` : 'no slide text matches';
        hitsSection.classList.toggle('hidden', false);
      } catch { hitsSection.classList.add('hidden'); }
    }, 220);
  }

  function render() {
    const filtering = search.value.trim().length > 0 || state.kind || state.vis || state.status || state.tag;
    searchSlides();
    // Shelves step aside while searching/filtering; an emptied shelf (all recents dismissed) stays hidden.
    shelves.forEach((s) => s.classList.toggle('hidden', !!filtering || (s.id !== 'archived' && s.querySelectorAll('.card').length === 0)));
    clearBtn.classList.toggle('hidden', !filtering);
    document.body.dataset.group = state.group;
    document.body.dataset.density = state.density;

    const visible = cards.filter(matches).sort(sorters[state.sort] || sorters.updated);
    const groups = new Map();
    for (const c of visible) {
      const key = state.group === 'none' ? 'All decks' : (labels[state.group](c) || 'Other');
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key).push(c);
    }
    // Groups ordered by their most recent deck (already sorted), except Year which is descending by label.
    const order = [...groups.keys()];
    if (state.group === 'year') order.sort((a, b) => b.localeCompare(a));

    groupsRoot.replaceChildren();
    for (const key of order) {
      const collapsed = !!state.collapsed[state.group + ':' + key] && !filtering;
      const sec = document.createElement('section');
      sec.className = 'section group' + (collapsed ? ' collapsed' : '');
      sec.dataset.groupKey = key;
      const head = document.createElement('div'); head.className = 'section-head';
      const btn = document.createElement('button'); btn.className = 'group-toggle'; btn.type = 'button'; btn.setAttribute('aria-expanded', String(!collapsed));
      btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg><h2></h2>`;
      btn.querySelector('h2').textContent = key;
      const count = document.createElement('span'); count.className = 'faint count'; count.textContent = `${groups.get(key).length} deck${groups.get(key).length === 1 ? '' : 's'}`;
      btn.addEventListener('click', () => { state.collapsed[state.group + ':' + key] = !state.collapsed[state.group + ':' + key]; save(); render(); });
      head.append(btn, count);
      const grid = document.createElement('div'); grid.className = 'grid cards-grid';
      grid.append(...groups.get(key));
      sec.append(head, grid);
      groupsRoot.append(sec);
    }
    noResults.classList.toggle('hidden', visible.length > 0);
  }

  search.addEventListener('input', render);
  groupSel.addEventListener('change', () => { state.group = groupSel.value; save(); render(); });
  sortSel.addEventListener('change', () => { state.sort = sortSel.value; save(); render(); });
  densityInputs.forEach((i) => i.addEventListener('change', () => { if (i.checked) { state.density = i.value; save(); render(); } }));
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const f = chip.dataset.filter, v = chip.dataset.value;
    state[f] = state[f] === v ? null : v;
    chips.forEach((c) => { if (c.dataset.filter === f) c.setAttribute('aria-pressed', String(state[f] === c.dataset.value)); });
    render();
  }));
  clearBtn.addEventListener('click', () => { state.kind = state.vis = state.status = state.tag = null; search.value = ''; chips.forEach((c) => c.setAttribute('aria-pressed', 'false')); render(); });

  document.addEventListener('click', (e) => {
    const t = e.target.closest('.card .tag[data-tag]');
    if (!t) return;
    e.preventDefault();
    state.tag = state.tag === t.dataset.tag ? null : t.dataset.tag;
    chips.forEach((c) => { if (c.dataset.filter === 'tag') c.setAttribute('aria-pressed', String(state.tag === c.dataset.value)); });
    render();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ---- Bulk selection: click the card's select box (or Space on a focused card); Shift+click selects a range. ----
  const selected = new Set();
  let lastSelected = null;
  const bulkbar = document.getElementById('bulkbar');
  // Shelves render their own copies of a deck's card; selection is by slug so every copy reflects it.
  const allCards = [...document.querySelectorAll('.card[data-slug]')];
  for (const c of allCards) {
    c.tabIndex = 0;
    const box = document.createElement('button');
    box.type = 'button'; box.className = 'select-box'; box.title = 'Select'; box.setAttribute('aria-pressed', 'false'); box.textContent = '✓';
    box.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); toggleSelect(c, e.shiftKey); });
    c.appendChild(box);
  }
  function toggleSelect(card, range = false) {
    const visible = allCards.filter((c) => !c.classList.contains('hidden') && c.offsetParent !== null);
    if (range && lastSelected && visible.includes(lastSelected) && visible.includes(card)) {
      const [a, b] = [visible.indexOf(lastSelected), visible.indexOf(card)].sort((x, y) => x - y);
      for (const c of visible.slice(a, b + 1)) selected.add(c.dataset.slug);
    } else if (selected.has(card.dataset.slug)) selected.delete(card.dataset.slug);
    else selected.add(card.dataset.slug);
    lastSelected = card;
    renderSelection();
  }
  function renderSelection() {
    for (const c of allCards) { const on = selected.has(c.dataset.slug); c.classList.toggle('selected', on); c.querySelector('.select-box')?.setAttribute('aria-pressed', String(on)); }
    bulkbar.classList.toggle('hidden', selected.size === 0);
    document.getElementById('bulk-count').textContent = `${selected.size} selected`;
  }
  async function bulk(fn, done) {
    const slugs = [...selected];
    let ok = 0, failed = 0;
    for (const slug of slugs) { try { await fn(slug, allCards.find((c) => c.dataset.slug === slug)); ok++; } catch { failed++; } }
    Podium.toast(`${done}: ${ok} deck${ok === 1 ? '' : 's'}${failed ? `, ${failed} failed` : ''}`, failed ? 'error' : 'ok');
    setTimeout(() => location.reload(), 700);
  }
  document.getElementById('bulk-clear').addEventListener('click', () => { selected.clear(); renderSelection(); });
  document.getElementById('bulk-vis').addEventListener('change', (e) => { const v = e.target.value; if (!v) return; if (v === 'Public' && !confirm(`Make ${selected.size} deck(s) Public? Anyone with the URL will be able to open them.`)) { e.target.value = ''; return; } bulk((s) => Podium.api('PATCH', `/api/decks/${s}`, { visibility: v }), `Visibility set to ${v}`); });
  document.getElementById('bulk-pin').addEventListener('click', () => bulk((s) => Podium.api('PATCH', `/api/decks/${s}`, { pinned: true }), 'Pinned'));
  document.getElementById('bulk-unpin').addEventListener('click', () => bulk((s) => Podium.api('PATCH', `/api/decks/${s}`, { pinned: false }), 'Unpinned'));
  document.getElementById('bulk-rebuild').addEventListener('click', () => bulk((s) => Podium.api('POST', `/api/decks/${s}/rebuild`), 'Rebuild queued'));
  document.getElementById('bulk-tags-apply').addEventListener('click', () => {
    const add = document.getElementById('bulk-tags').value.split(',').map((t) => t.trim()).filter(Boolean);
    if (!add.length) return;
    bulk((s, card) => Podium.api('PATCH', `/api/decks/${s}`, { tags: [...new Set([...(card.dataset.tags || '').split(' ').filter(Boolean), ...add])] }), 'Tags added');
  });

  // ---- New deck wizard: opens GitHub's new-file editor pre-filled with a starter deck. ----
  document.getElementById('new-deck')?.addEventListener('click', () => document.getElementById('new-deck-dialog').showModal());
  document.getElementById('help-btn').addEventListener('click', () => document.getElementById('help-dialog').showModal());
  document.getElementById('new-deck-dialog').addEventListener('close', () => {
    const dlg = document.getElementById('new-deck-dialog');
    if (dlg.returnValue !== 'create') return;
    const repo = document.getElementById('nd-repo');
    const ref = repo.selectedOptions[0]?.dataset.ref || 'main';
    const folder = document.getElementById('nd-folder').value.trim().replace(/^\/+|\/+$/g, '');
    const title = document.getElementById('nd-title').value.trim() || 'My talk';
    const kind = document.getElementById('nd-kind').value;
    if (!folder) return;
    const file = kind === 'slidev' ? 'slides.md' : 'main.md';
    const content = kind === 'slidev'
      ? `---\ntheme: default\ntitle: ${title}\ninfo: |\n  ## ${title}\nclass: text-center\ntransition: slide-left\n---\n\n# ${title}\n\nPress Space for the next slide\n\n<!--\nSpeaker notes go here; the audience never sees them.\n-->\n\n---\n\n# Second slide\n\n- Point one\n- Point two\n`
      : `---\ntitle: ${title}\nauthor: me\n---\n\nFirst slide\n===\n\nHello!\n\n<!-- end_slide -->\n\nSecond slide\n===\n\n- Point one\n- Point two\n`;
    const url = `https://github.com/${repo.value}/new/${encodeURIComponent(ref)}/${folder.split('/').map(encodeURIComponent).join('/')}?filename=${encodeURIComponent(file)}&value=${encodeURIComponent(content)}`;
    window.open(url, '_blank', 'noopener');
    Podium.toast(kind === 'presenterm' ? 'Also add a config.yaml next to main.md (presenterm needs one).' : 'Commit the file on GitHub; the deck appears here after the next sync.', 'ok');
  });

  document.addEventListener('click', async (e) => {
    const del = e.target.closest('[data-delete-deck]');
    if (!del) return;
    const slug = del.dataset.deleteDeck;
    if (!confirm(`Permanently delete "${slug}" with all its builds, grants and links? This cannot be undone.`)) return;
    del.disabled = true;
    try { await Podium.api('DELETE', `/api/decks/${slug}`); del.closest('tr').remove(); Podium.toast('Deck deleted', 'ok'); }
    catch (err) { del.disabled = false; Podium.toast(err.message, 'error'); }
  });

  // Shelves (Pinned, Recently presented, Archived) are server-rendered but behave like any other group: collapsible, remembered.
  for (const shelf of shelves) {
    const key = shelf.dataset.groupKey;
    const btn = shelf.querySelector('.group-toggle');
    if (shelf.id === 'archived' && !(key in state.collapsed)) state.collapsed[key] = true; // archived starts folded
    const apply = () => { const collapsed = !!state.collapsed[key]; shelf.classList.toggle('collapsed', collapsed); btn.setAttribute('aria-expanded', String(!collapsed)); };
    btn.addEventListener('click', () => { state.collapsed[key] = !state.collapsed[key]; save(); apply(); });
    apply();
  }

  // Remove a deck from "Recently presented" (it returns the next time it is presented).
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-dismiss-recent]');
    if (!btn) return;
    e.preventDefault();
    const slug = btn.dataset.dismissRecent;
    const card = btn.closest('.card');
    btn.disabled = true;
    try {
      await Podium.api('POST', `/api/recent/${slug}/dismiss`);
      card.remove();
      const shelf = document.getElementById('recent-shelf');
      const left = shelf.querySelectorAll('.card').length;
      shelf.querySelector('[data-recent-count]').textContent = `${left} deck${left === 1 ? '' : 's'}`;
      if (left === 0) shelf.classList.add('hidden');
      Podium.toast('Removed from recently presented', 'ok');
    } catch (err) { btn.disabled = false; Podium.toast(err.message, 'error'); }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== search && !/input|textarea|select/i.test(document.activeElement?.tagName || '')) { e.preventDefault(); search.focus(); search.select(); }
    if (e.key === 'Escape' && document.activeElement === search) { search.value = ''; render(); search.blur(); }
    if (e.key === '?' && !/input|textarea|select/i.test(document.activeElement?.tagName || '')) { e.preventDefault(); document.getElementById('help-dialog').showModal(); }
    if (e.key === ' ' && document.activeElement?.classList.contains('card')) { e.preventDefault(); toggleSelect(document.activeElement); }
  });
  render();

  // Keep build status fresh while anything is building.
  let polling = @(Model.AnyBuilding ? "true" : "false");
  async function poll() {
    try {
      const decks = await Podium.api('GET', '/api/decks');
      let busy = false;
      for (const d of decks) {
        const els = document.querySelectorAll(`.card[data-slug="${d.slug}"]`);
        const status = d.latestBuildStatus;
        const isBusy = status === 'Queued' || status === 'Running';
        busy = busy || isBusy;
        els.forEach((el) => {
          const dot = el.querySelector('.card-meta .dot');
          if (dot) dot.className = 'dot ' + (status === 'Succeeded' ? 'dot-ok' : status === 'Failed' ? 'dot-bad' : isBusy ? 'dot-busy' : '');
          const label = el.querySelector('[data-status-label]');
          if (label) label.textContent = isBusy ? (status === 'Queued' ? 'Queued' : 'Building') : status === 'Succeeded' ? 'Built' : status === 'Failed' ? (d.currentBuildId ? 'Last build failed (serving previous)' : 'Build failed') : 'Not built';
          const short = el.querySelector('[data-status-short]');
          if (short) short.textContent = isBusy ? (status === 'Queued' ? 'Queued' : 'Building') : status === 'Succeeded' ? 'Built' : status === 'Failed' ? 'Failed' : 'Not built';
          const statusEl = el.querySelector('.card-meta .status');
          if (statusEl && label) statusEl.title = label.textContent;
          el.dataset.status = isBusy ? 'building' : status === 'Failed' ? 'failed' : 'ok';
        });
      }
      if (busy) setTimeout(poll, 5000); else if (polling) { polling = false; location.reload(); }
    } catch { setTimeout(poll, 15000); }
  }
  if (polling) setTimeout(poll, 4000);
})();
</script>
}
