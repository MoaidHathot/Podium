<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Acornima" Version="1.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests host Podium.Web in-process (WebApplicationFactory), so they run on the ASP.NET Core shared framework.
         Saying so explicitly lets restore prune the framework's packages (DataProtection, System.Security.Cryptography.*)
         from the dependency graph, as it does for Podium.Web itself: the package copies are never loaded (the shared
         framework's are), and the audit no longer flags advisories against them. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Podium.Core\Podium.Core.csproj" />
    <ProjectReference Include="..\..\src\Podium.Web\Podium.Web.csproj" />
  </ItemGroup>

</Project>